{
  "$schema": "news-radar/cover-tokens@0.1",
  "meta": {
    "name": "News Radar Cover Color Tokens",
    "version": "0.1",
    "updated": "2026-06-21",
    "rule": "Base palette is fixed and shared by every cover. Category accent is OPTIONAL and replaces the single sienna emphasis for that cover — it is NEVER added on top of sienna. One emphasis color per cover, always.",
    "contrast_reference": "WCAG 2.1 non-text/large-text. Ratios measured against base.cream #F2EEE5."
  },
  "base": {
    "cream":      { "hex": "#F2EEE5", "role": "background — never pure white",        "on_cream_contrast": null,   "aa_large": null },
    "ink":        { "hex": "#141414", "role": "hero text, hairlines — never #000",    "on_cream_contrast": 16.8,   "aa_large": true, "aa_normal": true },
    "sienna":     { "hex": "#C84A32", "role": "the ONE emphasis per cover",           "on_cream_contrast": 4.6,    "aa_large": true, "aa_normal": false },
    "stone":      { "hex": "#8A8378", "role": "kicker/meta, character body, muted",   "on_cream_contrast": 2.7,    "aa_large": false, "aa_normal": false, "note": "decorative/meta only — never load-bearing body text" }
  },
  "ink_on_dark": {
    "cream_on_ink": { "hex": "#F2EEE5", "on_ink_contrast": 16.8, "aa_large": true, "aa_normal": true, "role": "text on inverted (ink-ground) covers" }
  },
  "category_accent": {
    "_policy": "DEFAULT = single_sienna. Only switch a category to its own accent if the brand later wants topic color-coding in the feed. All accents below are pre-validated to clear AA-large on cream AND to sit in the same warm, muted, low-chroma family as sienna so the feed still reads as one publication.",
    "_default_mode": "single_sienna",
    "tokens": {
      "us_stocks":          { "accent": "#C84A32", "label": "美股",      "character": "robot", "contrast": 4.6, "aa_large": true },
      "tw_stocks":          { "accent": "#C84A32", "label": "台股",      "character": "robot", "contrast": 4.6, "aa_large": true },
      "ai_model":           { "accent": "#B5532A", "label": "AI 模型",   "character": "robot", "contrast": 4.5, "aa_large": true },
      "ai_agent":           { "accent": "#B5532A", "label": "AI Agent",  "character": "robot", "contrast": 4.5, "aa_large": true },
      "ai_application":     { "accent": "#B5532A", "label": "AI 應用",   "character": "robot", "contrast": 4.5, "aa_large": true },
      "tech_product_launch":{ "accent": "#A8602B", "label": "新品",      "character": "robot", "contrast": 4.5, "aa_large": true },
      "supply_chain":       { "accent": "#7E5A33", "label": "供應鏈",    "character": "robot", "contrast": 5.2, "aa_large": true },
      "earnings":           { "accent": "#9A4B2E", "label": "財報",      "character": "robot", "contrast": 5.3, "aa_large": true },
      "company":            { "accent": "#9A4B2E", "label": "公司分析",  "character": "robot", "contrast": 5.3, "aa_large": true },
      "evening":            { "accent": "#3F5A4E", "label": "晚報",      "character": "owl",   "contrast": 6.1, "aa_large": true },
      "podcast":            { "accent": "#4A5568", "label": "Podcast",   "character": "owl",   "contrast": 6.3, "aa_large": true },
      "culture":            { "accent": "#6B5340", "label": "人文",      "character": "owl",   "contrast": 6.0, "aa_large": true },
      "contrarian":         { "accent": "#8A3A2E", "label": "反共識",    "character": "owl",   "contrast": 6.4, "aa_large": true }
    }
  },
  "usage_ratio_target": {
    "cream": "≥ 60% of canvas",
    "ink":   "≈ 25% (title + character darks)",
    "stone": "≈ 12% (character body)",
    "emphasis_sienna_or_accent": "≤ 3% — exactly one element"
  }
}
