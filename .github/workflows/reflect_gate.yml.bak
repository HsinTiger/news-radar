name: News Radar · Gate Analyzer (Daily)

# ------------------------------------------------------------
# Phase 9 Item 7 (2026-04-28) — daily publish cadence analysis
# and gate constraint tuning.
#
# Reads `publish_log` (recent 14 days) and writes per-platform
# relax_gate proposals to `data/05_reflect/proposals/YYYY-WW.jsonl`
# via the Item 2 write-path API.
#
# Tracks three metrics (14d window):
#   - emergency_publish rate (% publishes within 30min of previous)
#   - max_silence_breach (4-hour windows without publishes)
#   - cooldown_lock saturation (% publishes within min-interval)
#
# Calibration-phase (Phase 9 §8.4): every proposal is PROPOSAL-ONLY
# (boss_attention_required=True) — this analyzer never auto-deploys.
#
# Skip lineage rows (no jsonl entry) for:
#   - insufficient_samples (< 20 successful publishes in 14d per platform)
#
# Runs daily at 04:30 UTC (≈ 12:30 Asia/Taipei) — chosen so it lands
# AFTER Item 6's `reflect_scorer.yml` (04:00 UTC), avoiding same-time
# CI contention on the `news-radar-pipeline` concurrency group.
# Doesn't collide with `reflect_topic.yml` (Sun 22:00 UTC weekly).
# ------------------------------------------------------------

on:  # DEPRECATED: replaced by full_pipeline.yml
#   schedule:
#     # Daily 04:30 UTC = 12:30 Asia/Taipei
#     # PAUSED 2026-05-22 · - cron: "30 4 * * *"
#   workflow_dispatch:
    inputs:
      dry_run:
        description: "Dry-run (no proposals written, no report file)"
        required: false
        default: "false"
        type: choice
        options: ["false", "true"]

concurrency:
  # Shares DB writes (proposals lineage table) with pipeline.yml +
  # other reflector workflows — serialize via the same group key.
  group: news-radar-pipeline
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  reflect_gate:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Checkout state branch
        uses: actions/checkout@v5
        continue-on-error: true
        with:
          ref: state
          path: _state

      - name: Setup Python 3.11
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Restore DB from state branch
        id: restore
        run: |
          mkdir -p data/01_harvest data/05_reflect/proposals logs
          if [ -d _state ] && [ -f _state/data/01_harvest/news_radar.db ]; then
            cp _state/data/01_harvest/news_radar.db data/01_harvest/news_radar.db
            echo "has_db=true" >> "$GITHUB_OUTPUT"
            echo "[restore] DB restored: $(du -h data/01_harvest/news_radar.db | cut -f1)"
          else
            echo "has_db=false" >> "$GITHUB_OUTPUT"
            echo "[restore] state branch has no DB → analyzer will report 0 samples and exit 0"
          fi
          # Carry over any existing proposals dir so this run appends to
          # the right ISO-week jsonl file rather than starting from empty.
          if [ -d _state/data/05_reflect/proposals ]; then
            cp -r _state/data/05_reflect/proposals/. data/05_reflect/proposals/ 2>/dev/null || true
          fi

      - name: Run gate analyzer
        env:
          TZ: Asia/Taipei
          PYTHONUNBUFFERED: "1"
        run: |
          FLAGS=""
          if [ "${{ inputs.dry_run }}" = "true" ]; then
            FLAGS="--dry-run"
          fi
          echo "[reflect_gate] flags=$FLAGS"
          python -m src.reflector.gate $FLAGS | tee logs/reflect_gate_last.log

      - name: Commit gate report to main
        if: inputs.dry_run != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          if [ ! -d reports ] || [ -z "$(ls -A reports 2>/dev/null)" ]; then
            echo "[report] no gate report produced; skipping commit"
            exit 0
          fi
          git config user.name "news-radar-bot"
          git config user.email "noreply@github.com"
          git add reports/ 2>/dev/null || true
          if ! git diff --cached --quiet; then
            git commit -m "reflect: daily gate analyzer (run ${{ github.run_id }})"
            git push
          else
            echo "[report] no new report files; skipping commit"
          fi

      - name: Persist state (DB + proposals dir)
        if: always() && inputs.dry_run != 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          RUN_ID: ${{ github.run_id }}
        run: |
          STATE_DIR="$(mktemp -d)"
          cd "$STATE_DIR"
          git init -q -b state
          git config user.name "news-radar-bot"
          git config user.email "noreply@github.com"

          mkdir -p data/01_harvest data/05_reflect/proposals logs state archive
          if [ -f "$GITHUB_WORKSPACE/data/01_harvest/news_radar.db" ]; then
            cp "$GITHUB_WORKSPACE/data/01_harvest/news_radar.db" data/01_harvest/news_radar.db
          fi
          if [ -d "$GITHUB_WORKSPACE/data/05_reflect/proposals" ]; then
            cp -r "$GITHUB_WORKSPACE/data/05_reflect/proposals/." data/05_reflect/proposals/ 2>/dev/null || true
          fi
          if [ -d "$GITHUB_WORKSPACE/logs" ]; then
            cp -r "$GITHUB_WORKSPACE/logs/." logs/ 2>/dev/null || true
          fi

          cat > LAST_RUN.txt <<EOF
          last_run_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)
          run_id: ${RUN_ID}
          kind: reflect_gate
          EOF

          if [ -f data/01_harvest/news_radar.db ]; then
            echo "db_size: $(du -h data/01_harvest/news_radar.db | cut -f1)" >> LAST_RUN.txt
          fi

          git add -A
          if git diff --cached --quiet; then
            echo "[persist] no changes; skipping push"
            exit 0
          fi
          git commit -q -m "state: reflect_gate run ${RUN_ID}"
          git push --force \
            "https://x-access-token:${GH_TOKEN}@github.com/${REPO}.git" \
            state

      - name: Upload report + log as artifact
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: reflect-gate-${{ github.run_id }}
          path: |
            reports/
            logs/reflect_gate_last.log
            data/05_reflect/proposals/
          retention-days: 30
          if-no-files-found: warn
