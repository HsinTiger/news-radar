<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>HOME_DIR/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.hsin.news-radar.daily-publish</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>cd HOME_DIR/news_radar &amp;&amp; .venv/bin/python -u -m substack_radar.daily_publish</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>HOME_DIR/Library/Logs/news-radar/daily-publish.log</string>
	<key>StandardOutPath</key>
	<string>HOME_DIR/Library/Logs/news-radar/daily-publish.log</string>
	<key>StartCalendarInterval</key>
	<!-- 早上組：07:30 正式發（沒寫完會等到 08:15），14:30 補發第二輪重寫；傍晚組（10/19 起四週的雙數週）：17:00 正式發，18:30 補發。一天最多一篇。組別由 daily_publish.send_arm 決定 -->
	<array>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
	</array>
</dict>
</plist>
