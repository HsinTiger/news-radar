<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>HOME_DIR/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.hsin.news-radar.daily-publish</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>cd HOME_DIR/news_radar &amp;&amp; .venv/bin/python -u -m substack_radar.daily_publish</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>HOME_DIR/Library/Logs/news-radar/daily-publish.log</string>
	<key>StandardOutPath</key>
	<string>HOME_DIR/Library/Logs/news-radar/daily-publish.log</string>
	<key>StartCalendarInterval</key>
	<!-- 一天一個寄出時段：早上週 07:30、傍晚週（10/19–11/15 的雙數週）17:00。沒有補發 -->
	<array>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
	</array>
</dict>
</plist>
