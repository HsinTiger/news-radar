<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每週日 09:00：同一個 governed worker 先選公司，再建立一篇 Weekly 公司分析草稿。
     只建草稿，不發布。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hsin.news-radar.company-compose</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>HOME_DIR/bin/news_radar_substack_editorial.sh</string>
        <string>weekly</string>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/news-radar-company-compose.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/news-radar-company-compose.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
