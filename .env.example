# ==========================================================
# News Radar · 環境變數範本
# 複製為 .env 並填入實際值（.env 已加入 .gitignore，不會被推到雲端）
# 部署雲端時這些 key 會變成 GitHub Actions Secrets（見 docs/SECRETS_CHECKLIST.md）
# ==========================================================

# ---------- Meta App（共用）----------
META_APP_ID=
META_APP_SECRET=

# ---------- Facebook Page ----------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---------- Instagram（Business 帳號）----------
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# ---------- Threads ----------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Threads 專屬 App（換發 token 會用到；沒填的話到期需手動重發）
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---------- LLM API ----------
# Gemini：Scorer / Composer / Reflector 主要 LLM（必填）
GEMINI_API_KEY=

# Anthropic：competitor_agent 用（建議填；沒有的話競品分析會降級）
ANTHROPIC_API_KEY=

# ---------- 可選：Composer model override ----------
# 預設 gemini-2.0-flash-lite；改 gemini-2.0-flash 可提升品質但稍慢
# NEWS_RADAR_COMPOSER_MODEL=gemini-2.0-flash-lite

# ---------- Reflector tuning ----------
# 最少要有幾個 sample reflector 才會跑；預設 3
# REFLECTOR_MIN_SAMPLES=3

# ---------- 通知（可選）----------
# 若想在 Token 失效 / 信心分突降時收 email 提醒
NOTIFY_EMAIL=

# ---------- Substack notify channel (Phase 9.x, 2026-05-13) ----------
# Pipeline 自動跑完後，主動推給作者本人。
#   SUBSTACK_NOTIFY_CHANNEL = "gmail" | "macos" | "both" | "none"（預設不通知）
#   SUBSTACK_NOTIFY_EMAIL   = 收件信箱（在外用手機收）
#   GMAIL_APP_PASSWORD      = Gmail App Password（16 字，需先開 2FA）
#                             https://myaccount.google.com/apppasswords
# 設置範例：
#   SUBSTACK_NOTIFY_CHANNEL=gmail
#   SUBSTACK_NOTIFY_EMAIL=hsin290525@gmail.com
#   GMAIL_APP_PASSWORD=abcdefghijklmnop
SUBSTACK_NOTIFY_CHANNEL=
SUBSTACK_NOTIFY_EMAIL=
GMAIL_APP_PASSWORD=
