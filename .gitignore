# ============================================================
# News Radar · .gitignore  (main branch = 純程式碼)
# ------------------------------------------------------------
# 原則：
#   - 秘鑰一律不入庫（用 GitHub Actions Secrets）
#   - runtime 產物（DB、logs、archive）不在 main branch，活在 state branch
#   - OS / IDE / venv 噪音一律擋掉
# ============================================================

# --- 秘鑰 / 本機設定 ---
.env
.env.local
.env.*.local
# macOS / OneDrive duplicate（常見型態："xxx 2"）
.env 2
.env.local 2

# --- Substack draft pipeline (Phase 1, 2026-05-12) ---
# 每篇 draft 同步到 OneDrive autogen/，本地 data/substack_drafts/ 是工作目錄
data/substack_drafts/
config/substack_evening_topics.cursor

# --- Python runtime ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- venv ---（不加斜線 → 同時擋目錄與 symlink）
.venv
.venv*
venv
venv*
env/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- runtime 產物（這些活在 state branch，不污染 main）---
news_radar.db
news_radar.db-journal
news_radar.db-wal
news_radar.db-shm
# 整個 data/ 都是運行期 / 策略性內容 → 不入 main
# 例外：結構定義要可 code review（schema.sql、views.sql、migrations/）
data/*
!data/01_harvest
data/01_harvest/*
!data/01_harvest/schema.sql
!data/01_harvest/views.sql
!data/01_harvest/migrations
!data/01_harvest/migrations/*.sql
logs/
archive/
scratch/
state/last_harvest.txt

# --- 根目錄的 scratch 測試 / 策略檔 ---
test_fb.py
test_parse.py
test_playwright.py
strategic_directives.md

# --- Meta 驗證臨時產物 ---
fb_dom.html
*_dom.html
drafts_for_review.csv

# --- 診斷報告（會被 make diag 重新產生）---
data/01_harvest/diagnostic_report.md
data/01_harvest/feeds_health.md

# --- Playwright / Puppeteer 快取 ---
.playwright/
playwright-report/
test-results/

# --- 其他 ---
*.log
tmp/
.tmp/
AGENT_WORKLOG.md

# --- Cover-renderer assets (large + per-machine) ---
# Fonts are downloaded once locally per docs/brand_visual.md. Large files,
# OFL-licensed, no need to track in git.
assets/fonts/*.otf
assets/fonts/*.ttf
assets/fonts/*.ttc
# Generated cover PNGs are runtime cache, not source.
assets/cover_cache/
# Downloaded news images (image_manager.download_image) + the synthetic
# fallback cover_pipeline generates when news has no usable og:image.
# All runtime, all regenerable, none belong in main.
assets/image_cache/
# Stale sandbox-leftover (delete locally then drop this line)
assets/fonts/_sample_cjk.ttf

# --- Emergency oneshot ephemeral state ---
# Breadcrumb written by tools/emergency_oneshot.py so the bash wrapper can
# pick up the draft_id for push_state.sh --expect-draft. Regenerated every run.
tools/.last_emergency_draft_id

# minimal-context sandbox for Claude CLI (auto-created)
.claude_min/
